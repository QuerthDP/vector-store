#!/bin/bash
#
# Sets up a local conda env with `libcuvs` for building vector-store with `--features gpu`.
# Usage: [sudo] ./scripts/setup-gpu [--verify | --github-env]
#
# `--github-env` exports the build environment to the following GitHub
# Actions steps instead of pointing `.cargo/config.toml` at the prefix.
#
# `sudo` is only needed when the prefix (`VECTOR_STORE_CUVS_GPU_PREFIX`,
# default `/opt/vector-store-cuvs-gpu`) is not writable by the current user.

set -euo pipefail

log() { echo "==> $*" >&2; }
err() { echo "error: $*" >&2; }

filter_conda_noise() {
    sed -e '/^#/d' -e '/To enable CUDA support, UCX requires/,/have been installed for you\.$/d' -e '/^$/d'
}

verify=false
github_env=false
for arg in "$@"; do
    case "$arg" in
        --verify) verify=true ;;
        --github-env) github_env=true ;;
        *)
            err "unknown argument: $arg"
            exit 1
            ;;
    esac
done

if $github_env; then
    if $verify; then
        err "--verify checks the build set up by the cargo config, which --github-env leaves alone."
        exit 1
    fi
    if [[ -z "${GITHUB_ENV:-}" || -z "${GITHUB_PATH:-}" ]]; then
        err "--github-env only works in GitHub Actions (GITHUB_ENV or GITHUB_PATH is unset)."
        exit 1
    fi
fi

repo=$(realpath "$(dirname "${BASH_SOURCE[0]}")/..")
PREFIX="${VECTOR_STORE_CUVS_GPU_PREFIX:-/opt/vector-store-cuvs-gpu}"
MICROMAMBA_VERSION="2.10.0-0"
micromamba="$PREFIX/bin/micromamba"
ENV_PREFIX="$PREFIX/env"

# Root is only needed for a prefix the user cannot write to, like the default
# one in `/opt`.
existing=$PREFIX
while [[ ! -e "$existing" ]]; do existing=$(dirname "$existing"); done
if [[ ! -w "$existing" ]]; then
    err "$PREFIX is not writable: run with sudo, as your normal user, or set VECTOR_STORE_CUVS_GPU_PREFIX."
    exit 1
fi

if ! command -v nvidia-smi &>/dev/null || ! nvidia-smi &>/dev/null; then
    err "working NVIDIA driver (nvidia-smi) required."
    exit 1
fi
log "NVIDIA driver OK"

command -v python3 &>/dev/null || { err "python3 is required (used to resolve conda package metadata)."; exit 1; }

# .cargo/config.toml is checked in with a fixed CMAKE_PREFIX_PATH/rpath so a plain
# `cargo build --features gpu` just works with no exporting/sourcing.
# When a non-default prefix is requested, rewrite those two lines in place to match,
# so the build actually looks in $ENV_PREFIX instead of silently keeping the checked-in default.
cargo_config="$repo/.cargo/config.toml"
if ! $github_env && ! grep -qF "CMAKE_PREFIX_PATH = \"$ENV_PREFIX\"" "$cargo_config"; then
    log "Pointing $cargo_config at $ENV_PREFIX"
    sed -i -E "s#^CMAKE_PREFIX_PATH = \".*\"#CMAKE_PREFIX_PATH = \"$ENV_PREFIX\"#" "$cargo_config"
    sed -i -E "s#-rpath,[^\"]*/lib#-rpath,$ENV_PREFIX/lib#" "$cargo_config"
    if [[ "$PREFIX" != /opt/vector-store-cuvs-gpu ]]; then
        log "NOTE: $cargo_config now points at a non-default, local-only prefix — avoid committing it."
    fi
fi

cuvs_sys_version=$(awk '/^name = "cuvs-sys"$/{getline; print; exit}' "$repo/Cargo.lock" | sed -n 's/^version = "\(.*\)"$/\1/p')
[[ -n "$cuvs_sys_version" ]] || { err "cuvs-sys version not found in Cargo.lock"; exit 1; }
major_minor=$(echo "$cuvs_sys_version" | cut -d. -f1-2)
log "cuvs-sys is resolved to version $cuvs_sys_version (need libcuvs $major_minor.x)"

if [[ "$("$micromamba" --version 2>/dev/null)" != "${MICROMAMBA_VERSION%-*}" ]]; then
    arch=$(uname -m)
    case "$arch" in
        x86_64)
            platform=linux-64
            expected_sha256=701f39c06f8e6a670a0e186c8479b9e5c0502a2f0cda6cef65d83bdd2875e8bd
            ;;
        aarch64)
            platform=linux-aarch64
            expected_sha256=3bb56786e21b9b24024f599fe9185b4a59dc3f9f59937a42311ee583adbbb23c
            ;;
        *)
            err "unsupported architecture: $arch (micromamba only auto-installs for x86_64/aarch64)"
            exit 1
            ;;
    esac

    url="https://github.com/mamba-org/micromamba-releases/releases/download/$MICROMAMBA_VERSION/micromamba-$platform"
    log "Installing micromamba $MICROMAMBA_VERSION into $micromamba"
    tmp_dir=$(mktemp -d)
    trap 'rm -rf "$tmp_dir"' EXIT
    curl -fL --progress-bar "$url" -o "$tmp_dir/micromamba"

    actual_sha256=$(sha256sum "$tmp_dir/micromamba" | awk '{print $1}')
    if [[ "$expected_sha256" != "$actual_sha256" ]]; then
        err "micromamba checksum mismatch (expected $expected_sha256, got $actual_sha256)"
        exit 1
    fi

    mkdir -p "$PREFIX/bin"
    install -m 755 "$tmp_dir/micromamba" "$micromamba"
    rm -rf "$tmp_dir"
    trap - EXIT
fi

log "Resolving the latest libcuvs $major_minor.x package"
resolved=$(python3 - "$major_minor" <<'PY'
import json, re, sys, urllib.request

mm = sys.argv[1]
found_channel_data = False

for c in ("rapidsai", "rapidsai-nightly"):
    try:
        data = json.load(urllib.request.urlopen(
            f"https://conda.anaconda.org/{c}/linux-64/repodata.json", timeout=60))
    except Exception as e:
        print(f"warning: failed to fetch {c} repodata: {e}", file=sys.stderr)
        continue
    found_channel_data = True

    pkgs = {**data.get("packages", {}), **data.get("packages.conda", {})}
    cands = [
        meta for meta in pkgs.values()
        if meta.get("name") == "libcuvs" and meta.get("version", "").startswith(mm + ".")
    ]
    if not cands:
        continue

    latest_ts = max(meta["timestamp"] for meta in cands)
    best = sorted(
        [meta for meta in cands if meta["timestamp"] == latest_ts],
        key=lambda meta: 0 if "cuda12" in meta["build"] else 1,
    )[0]
    cv = re.search(r"cuda(\d+)", best["build"])
    print(f"{c} libcuvs {best['version']} {best['build']} {cv.group(1) if cv else '12'}")
    sys.exit(0)

if not found_channel_data:
    print("no channel repodata could be fetched (network/DNS issue?)", file=sys.stderr)
sys.exit(1)
PY
) || { err "libcuvs $major_minor.x not found on rapidsai/rapidsai-nightly (see warnings above)."; exit 1; }

read -r channel pkg_name pkg_version pkg_build cuda_version <<< "$resolved"
log "Resolved: $channel::$pkg_name=$pkg_version=$pkg_build (cuda $cuda_version)"

specs=("$pkg_name=$pkg_version=$pkg_build" "cuda-version=$cuda_version.*" "cuda-cudart=$cuda_version.*" cmake pkg-config)
# The stamp is written only after a complete install, so an interrupted one
# is retried, and a change of any requested package installs again.
stamp="$ENV_PREFIX/.setup-gpu-stamp"
if [[ -f "$stamp" && "$(<"$stamp")" == "$channel ${specs[*]}" ]]; then
    log "$pkg_name $pkg_version ($pkg_build) is already installed in $ENV_PREFIX"
else
    conda_action="create"
    [[ -d "$ENV_PREFIX/conda-meta" ]] && conda_action="install"
    log "$([[ "$conda_action" == create ]] && echo Creating || echo Installing) conda env at $ENV_PREFIX"

    "$micromamba" "$conda_action" -y -r "$PREFIX/micromamba" -p "$ENV_PREFIX" -c "$channel" -c conda-forge -c nvidia \
        "${specs[@]}" 2>&1 | filter_conda_noise
    echo "$channel ${specs[*]}" >"$stamp"

    [[ $EUID -ne 0 ]] || chmod -R a+rX "$PREFIX"
fi

if $github_env; then
    log "Exporting the build environment to the following steps"
    mkdir -p "$PREFIX/path"
    ln -sf "$ENV_PREFIX/bin/cmake" "$PREFIX/path/cmake"
    echo "$PREFIX/path" >>"$GITHUB_PATH"
    echo "CMAKE_PREFIX_PATH=$ENV_PREFIX" >>"$GITHUB_ENV"
    # `RUSTFLAGS` replaces the `rustflags` of `.cargo/config.toml`,
    # so it needs the rpath to `libcuvs` as well.
    echo "RUSTFLAGS=${RUSTFLAGS:-} -C link-arg=-Wl,-rpath,$ENV_PREFIX/lib" >>"$GITHUB_ENV"
fi

if $verify; then
    log "Verifying: cargo check -p vector-store --features gpu"
    check=(bash -lc "cd '$repo' && cargo check -p vector-store --features gpu")
    [[ -z "${SUDO_USER:-}" ]] || check=(runuser -u "$SUDO_USER" -- "${check[@]}")
    "${check[@]}" || { err "Verification failed"; exit 1; }
    log "Verification succeeded"
fi

log "Done."
